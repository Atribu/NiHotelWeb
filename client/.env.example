# SMTP server used by the contact form
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
# Set true when using port 587 with STARTTLS
SMTP_REQUIRE_TLS=false
# Keep true whenever the SMTP server has a valid TLS certificate.
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=website@example.com
SMTP_PASS=change-me
# Optional. Defaults to SMTP_USER
SMTP_FROM_EMAIL=website@example.com

# Optional. Defaults to info@teonahotel.com
CONTACT_TO_EMAIL=info@teonahotel.com

# Teona AI Assistant trial
# In local development the assistant is shown unless this is explicitly false.
# In production it is shown only when this is true.
NEXT_PUBLIC_TEONA_AI_ASSISTANT_ENABLED=false
# Keep this server-side value out of NEXT_PUBLIC variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
